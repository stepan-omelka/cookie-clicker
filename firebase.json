{
  "hosting": {
    "public": "frontend/dist/frontend/browser",
    "ignore": ["**/.*"],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": { "serviceId": "cookie-clicker-api", "region": "europe-west1" }
      },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
